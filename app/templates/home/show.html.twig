{% extends 'base.html.twig' %}

{% block title %}Détail de l'objet{% endblock %}

{% block body %}
<div class="container mt-5">
    <h1 class="mb-4">{{ item.title }}</h1>

    <div class="card shadow-sm">
        <div class="card-body">

            <p>
                <strong>Description :</strong>
                {{ item.description ?? 'Aucune description disponible.' }}
            </p>

            <p>
                <strong>Prix de départ :</strong> {{ item.startingPrice }} €
            </p>

            <p>
                <strong>Statut :</strong>
                {% if item.status == 'published' %}
                    publié
                {% elseif item.status == 'closed' %}
                    clôturé
                {% else %}
                    non publié
                {% endif %}
            </p>
            {% if item.status == 'closed' %}
            <p>
            <strong>Gagnant :</strong>
            {{ item.winner ? item.winner.email : 'Aucun gagnant' }}
           </p>
           {% endif %}
            <a href="{{ path('app_item_offer', {id: item.id}) }}" class="btn btn-warning">
            Enchérir
            </a>
            <a href="{{ path('app_home') }}" class="btn btn-secondary">Retour</a>

        </div>
    </div>
</div>
{% endblock %}
