{% extends 'base.html.twig' %}
{% block title %}Administration{% endblock %}
{% block body %}
<div class="container mt-5">
    <h1>Administration — Tous les objets</h1>
    <table class="table table-striped mt-4">
        <thead>
            <tr>
                <th>Titre</th>
                <th>Prix</th>
                <th>Statut</th>
                <th>Offres</th>
                <th>Action</th>
            </tr>
        </thead>
        <tbody>
            {% for item in items %}
            <tr>
                <td>{{ item.title }}</td>
                <td>{{ item.startingPrice }} €</td>
                <td>
                    {% if item.status == 'unpublished' %}Non publié
                    {% elseif item.status == 'published' %}Publié
                    {% elseif item.status == 'closed' %}Fermé
                    {% endif %}
                </td>
                <td>{{ item.offers|length }}</td>
                <td>
                    <a href="{{ path('app_admin_show', {'id': item.id}) }}" class="btn btn-sm btn-primary">Voir</a>
                </td>
            </tr>
            {% endfor %}
        </tbody>
    </table>
</div>
{% endblock %}